# Append to ~/.config/matugen/config.toml (create the file if it does not exist).
# Copy screen-ai-colors.conf into ~/.config/matugen/templates/ first:
#   mkdir -p ~/.config/matugen/templates ~/.config/screen-ai
#   cp theming/matugen/screen-ai-colors.conf ~/.config/matugen/templates/
[templates.screen-ai]
input_path = '~/.config/matugen/templates/screen-ai-colors.conf'
output_path = '~/.config/screen-ai/colors.conf'
